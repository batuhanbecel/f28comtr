# Public site URL (canonical, sitemap, OG)
NEXT_PUBLIC_SITE_URL=https://www.f28.com.tr

# ── Sanity ──────────────────────────────────────────────────────────────────
# sanity.io/manage adresinden projeyi oluşturduktan sonra alınır
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
# Migration scriptleri için Editor yetkili token
SANITY_API_WRITE_TOKEN=
# Visual Editing / draft mode için Viewer yetkili token
SANITY_API_READ_TOKEN=
# Sanity webhook → ISR revalidation secret (Sanity dashboard'daki webhook secret'i ile aynı)
SANITY_REVALIDATE_SECRET=

# ── Contact form (Gmail SMTP) ───────────────────────────────────────────────
CONTACT_SMTP_USER=
CONTACT_SMTP_PASS=
CONTACT_TO=info@f28.com.tr

# ── Optional ────────────────────────────────────────────────────────────────
# GOOGLE_SITE_VERIFICATION=
